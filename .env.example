# =============================================================================
# MENTORA AI — Environment Variables Template
# Architecture: Google Gemini API + Supabase PostgreSQL, Auth & Storage
# =============================================================================

# Backend Server AI Configuration (Server-side only — NEVER expose to browser)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Project Configuration (Client & Server)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend Supabase Service Role Key (Server-side only for trusted admin tasks — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Client API Base URL
VITE_API_BASE_URL=/api

# Server Settings
PORT=5000
NODE_ENV=development
